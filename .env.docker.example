# Copy to .env (repository root) for `docker compose up`.

# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

MYSQL_ROOT_PASSWORD=
DB_DATABASE=vacancy
DB_USERNAME=app
DB_PASSWORD=

# Public URL of the API as seen by the browser (without /api). Rebuild the frontend after changing it.
API_URL=http://localhost:8000

BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=warning

# Seed the admin user and sample vacancy on every backend start
DB_SEED=true
